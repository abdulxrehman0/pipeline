<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Simple Website</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #0f172a;
            color: #e5e7eb;
        }

        header {
            background: #020617;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            margin: 0;
            color: #38bdf8;
        }

        main {
            padding: 40px 20px;
            max-width: 800px;
            margin: auto;
            text-align: center;
        }

        .card {
            background: #020617;
            padding: 25px;
            border-radius: 10px;
            margin-top: 30px;
        }

        button {
            background: #38bdf8;
            color: #020617;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 15px;
        }

        button:hover {
            background: #0ea5e9;
        }

        footer {
            background: #020617;
            text-align: center;
            padding: 15px;
            margin-top: 40px;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>
<body>

    <header>
        <h1>Welcome to My Website</h1>
        <p>A simple one-page HTML site</p>
    </header>

    <main>
        <h2>Hello 👋</h2>
        <p>This is a basic website made using only one HTML file.</p>

        <div class="card">
            <h3>About</h3>
            <p>You can host this on AWS EC2, GitHub Pages, or anywhere.</p>
            <button onclick="sayHello()">Click Me</button>
        </div>
    </main>

    <footer>
        © 2026 | Created by You
    </footer>

    <script>
        function sayHello() {
            alert("Hello! Your website is working 🚀");
        }
    </script>

</body>
</html>
